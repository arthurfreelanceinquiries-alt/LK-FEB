{
  "$schema": "https://opensource.google.com/design-tokens/dtcg-schema",
  "name": "Portal Ormawa BEM FEB UKRIDA",
  "description": "Design tokens W3C DTCG - Portal Ormawa BEM FEB UKRIDA. Primary UKRIDA Navy #0B2A5B, FEB Gold #FDB913.",
  "color": {
    "primary": {
      "DEFAULT": { "$value": "#0B2A5B", "$type": "color", "$description": "UKRIDA Navy - top navbar, sidebar, aksi primer" },
      "dark": { "$value": "#071C3D", "$type": "color", "$description": "Navy gelap - hover primer, sidebar bg" },
      "light": { "$value": "#134080", "$type": "color", "$description": "Royal blue - active tab, aksen interaktif" }
    },
    "secondary": {
      "DEFAULT": { "$value": "#FDB913", "$type": "color", "$description": "FEB Gold - CTA krusial, badge BPH" },
      "dark": { "$value": "#E5A50B", "$type": "color" },
      "light": { "$value": "#FEF3D6", "$type": "color" }
    },
    "surface": {
      "DEFAULT": { "$value": "#FFFFFF", "$type": "color" },
      "subtle": { "$value": "#F8FAFC", "$type": "color" },
      "muted": { "$value": "#F1F5F9", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "#0F172A", "$type": "color" },
      "secondary": { "$value": "#475569", "$type": "color" },
      "muted": { "$value": "#94A3B8", "$type": "color" },
      "inverse": { "$value": "#FFFFFF", "$type": "color" }
    },
    "border": {
      "subtle": { "$value": "#E2E8F0", "$type": "color" },
      "strong": { "$value": "#CBD5E1", "$type": "color" }
    },
    "success": {
      "DEFAULT": { "$value": "#10B981", "$type": "color" },
      "surface": { "$value": "#ECFDF5", "$type": "color" },
      "border": { "$value": "#A7F3D0", "$type": "color" }
    },
    "danger": {
      "DEFAULT": { "$value": "#EF4444", "$type": "color" },
      "surface": { "$value": "#FEF2F2", "$type": "color" },
      "border": { "$value": "#FECACA", "$type": "color" }
    },
    "warning": {
      "DEFAULT": { "$value": "#F59E0B", "$type": "color" },
      "surface": { "$value": "#FFFBEB", "$type": "color" },
      "border": { "$value": "#FDE68A", "$type": "color" }
    },
    "info": {
      "DEFAULT": { "$value": "#3B82F6", "$type": "color" },
      "surface": { "$value": "#EFF6FF", "$type": "color" },
      "border": { "$value": "#BFDBFE", "$type": "color" }
    }
  },
  "fontFamily": {
    "sans": { "$value": ["Plus Jakarta Sans", "Inter", "system-ui", "sans-serif"], "$type": "fontFamilies" },
    "print": { "$value": ["Times New Roman", "Times", "serif"], "$type": "fontFamilies", "$description": "Khusus export DOCX/PDF formal" }
  },
  "fontSize": {
    "display-lg": { "$value": "32px", "$type": "fontSizes" },
    "display-md": { "$value": "24px", "$type": "fontSizes" },
    "h1": { "$value": "20px", "$type": "fontSizes" },
    "h2": { "$value": "18px", "$type": "fontSizes" },
    "h3": { "$value": "16px", "$type": "fontSizes" },
    "body-lg": { "$value": "16px", "$type": "fontSizes" },
    "body-md": { "$value": "14px", "$type": "fontSizes" },
    "body-sm": { "$value": "12px", "$type": "fontSizes" },
    "caption": { "$value": "11px", "$type": "fontSizes" }
  },
  "borderRadius": {
    "none": { "$value": "0px", "$type": "borderRadius" },
    "xs": { "$value": "4px", "$type": "borderRadius" },
    "sm": { "$value": "6px", "$type": "borderRadius" },
    "md": { "$value": "8px", "$type": "borderRadius" },
    "lg": { "$value": "12px", "$type": "borderRadius" },
    "xl": { "$value": "16px", "$type": "borderRadius" },
    "2xl": { "$value": "20px", "$type": "borderRadius" },
    "full": { "$value": "9999px", "$type": "borderRadius" }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "spacing" },
    "sm": { "$value": "8px", "$type": "spacing" },
    "md": { "$value": "12px", "$type": "spacing" },
    "lg": { "$value": "16px", "$type": "spacing" },
    "xl": { "$value": "20px", "$type": "spacing" },
    "2xl": { "$value": "24px", "$type": "spacing" },
    "3xl": { "$value": "32px", "$type": "spacing" },
    "4xl": { "$value": "48px", "$type": "spacing" }
  }
}
